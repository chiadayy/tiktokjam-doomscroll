# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Volcengine Ark. ARK_MODEL is an endpoint/model ID that supports the
# OpenAI-compatible Responses API, for example ep-xxxxxxxx.
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=ep-replace-with-your-endpoint-id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write

# Which model service Codex talks to: "ark" or "openai".
# "ark" is the starter kit default and uses the adapter in ark-proxy.ts,
# because Ark rejects Codex's multi-turn requests over a missing field.
# "openai" is Codex's native provider and needs no adapter.
MODEL_PROVIDER=ark
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1-codex
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# The egress guard. When true, the sensitive-egress, outbound-blob, and
# egress-intent checks run against every turn in the container runtime: a command
# that would send workspace secrets (.env, private keys, credential files) to the
# network is refused before it runs, and network access is dropped from the
# sandbox so those commands surface as permission requests. egress-intent also
# reads the agent's reasoning and refuses an outbound command when the narration
# stated an intent to move a secret off the machine. Off by default, so the agent
# runs exactly as it would unobserved. No effect on the local-process runner,
# which is not traced.
#
# Each guard in the family has its own GUARDRAIL_<NAME>_ENABLED flag so it can
# be tested in isolation. There is no master switch.
GUARDRAIL_EGRESS_ENABLED=false
# Optional. Overrides the built-in sensitive-path markers entirely.
# Comma-separated path substrings, e.g. ".env,id_rsa,secrets".
GUARDRAIL_SENSITIVE_MARKERS=
# Sandbox mode a guarded turn runs in, regardless of CODEX_SANDBOX_MODE.
# workspace-write keeps network denial and approval escalation meaningful,
# which is what lets the guard refuse an outbound command before it runs.
# Drop to danger-full-access only if the runtime cannot honour it.
GUARDRAIL_SANDBOX=workspace-write
# Minimum base64/hex run (characters) the outbound-blob check treats as an
# encoded blob. A blob this size leaving over a network channel is refused when
# a sensitive file was read earlier in the run, and recorded otherwise.
GUARDRAIL_BLOB_MIN_CHARS=128
# The agent-intent guard. When true, the agent's own reasoning narration is
# checked every turn for a stated intent to work around the guard, destroy data,
# exceed scope, exfiltrate a secret, make itself persistent, cover its tracks,
# or mislead the user. Warn-only: findings are recorded and shown in the
# trajectory but never interrupt a turn, so this needs no sandbox change.
# Independent of GUARDRAIL_EGRESS_ENABLED.
GUARDRAIL_INTENT_ENABLED=false
# Task-aware model assessment over meaningful trajectory checkpoints. This is
# separate from deterministic checks and is disabled by default.
GUARDRAIL_SEMANTIC_ENABLED=false
# Empty reuses OPENAI_MODEL / ARK_MODEL. Override with a cheaper compatible
# model when desired.
GUARDRAIL_SEMANTIC_MODEL=
GUARDRAIL_SEMANTIC_TIMEOUT_MS=15000

# Carry what a guard caught into this Agent's later runs (see reflections.ts).
# Stored as check parameters, never as prompt text, so it costs no tokens and
# survives a thread reset or a fresh container. Warn-only at any number of
# sightings: memory widens what the guards notice, never what they refuse.
# Independent of the other guard flags.
GUARDRAIL_REFLECTION_ENABLED=false

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000
